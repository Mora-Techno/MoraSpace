{
  "name": "api",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "dev": "bun run prisma:generate && bun --watch run src/serve.ts",
    "start": "bun run src/serve.ts",
    "build": "tsc",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write --unsafe src",
    "test": "bun test",
    "test:contracts": "bun run scripts/check-bruno-contracts.ts",
    "format": "biome format --write src",
    "format:check": "biome format src"
  },
  "dependencies": {
    "@elysia/opentelemetry": "^1.4.12",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@prisma/client": "^6.19.3",
    "@repo": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "elysia": "^1.4.30",
    "elysia-helmet": "^3.1.0",
    "form-data": "^4.0.6",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "swagger": "^0.7.5",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vercel/node": "^16.0.1",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
