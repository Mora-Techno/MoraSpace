{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moraspace",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "moraspace"
    }
  ],
  "vars": {
    "NODE_ENV": "development",
    "NEXT_PUBLIC_BASEPATH": "/home",
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },
  "env": {
    "staging": {
      "name": "moraspace-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "moraspace-staging"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_BASEPATH": "/home",
        "NEXT_PRIVATE_MINIMAL_MODE": "1"
      }
    },
    "production": {
      "name": "moraspace-prod",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "moraspace-prod"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_BASEPATH": "/home",
        "NEXT_PRIVATE_MINIMAL_MODE": "1"
      }
    }
  }
}
