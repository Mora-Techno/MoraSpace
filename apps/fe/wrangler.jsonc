{
  "$schema": "node_modules/wrangler/config-schema.json",

  // =====================================
  // Production (Default)
  // =====================================
  "name": "moraspace",
  "main": ".open-next/worker.js",

  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  "workers_dev": true,
  "keep_vars": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "moraspace"
    }
  ],

  "vars": {
    "NODE_ENV": "production",
    "APP_ENV": "production",
    "NEXT_PUBLIC_BASEPATH": "/home",
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  },

  // =====================================
  // Staging Environment
  // =====================================
  "env": {
    "staging": {
      "name": "moraspace-staging",

      "workers_dev": true,

      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "moraspace-staging"
        }
      ],

      "vars": {
        "NODE_ENV": "production",
        "APP_ENV": "staging",
        "NEXT_PUBLIC_BASEPATH": "/home",
        "NEXT_PRIVATE_MINIMAL_MODE": "1"
      }
    }
  }
}
